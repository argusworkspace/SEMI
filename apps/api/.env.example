# Neon PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Cashfree Payment Gateway (bypassed until approved — leave blank)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# OCR.space — free API for payment screenshot verification
# Get your key at https://ocr.space/ocrapi (25,000 req/month free)
OCR_SPACE_API_KEY=helloworld

# UPI payment details shown to customer
PAYMENT_UPI_ID=semy@ybl
PAYMENT_UPI_NAME=SEMY Mobility
