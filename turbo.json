{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "DATABASE_URL",
        "SECRET_KEY",
        "CORS_ORIGINS",
        "OCR_SPACE_API_KEY",
        "PAYMENT_UPI_ID",
        "PAYMENT_UPI_NAME",
        "SELLER_LEGAL_NAME",
        "SELLER_TRADE_NAME",
        "SELLER_ADDRESS",
        "SELLER_GSTIN",
        "SELLER_STATE",
        "SELLER_STATE_CODE",
        "SELLER_EMAIL",
        "SELLER_BANK_NAME",
        "SELLER_BANK_ACCOUNT",
        "SELLER_BANK_IFSC",
        "PRODUCT_HSN",
        "GST_RATE"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "format": {
      "cache": false
    }
  }
}
